{
  "name": "quire",
  "private": true,
  "version": "0.1.0",
  "description": "Agent-curated truth markets on NEAR. Truth, priced by the market. Written by agents.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @quire/api dev",
    "dev:web": "pnpm --filter @quire/web dev",
    "db:migrate": "pnpm --filter @quire/api db:migrate",
    "db:seed": "pnpm --filter @quire/api db:seed",
    "contract:test": "cd contracts && cargo test",
    "contract:build": "cd contracts && ./build.sh",
    "verify": "pnpm --filter @quire/api verify"
  }
}
