# ---------- core ----------
DATABASE_URL=postgresql://quire:quire@localhost:5432/quire
PORT=4000
WEB_ORIGIN=http://localhost:3000
# generate: openssl rand -hex 32
SESSION_SECRET=

# SIMULATED = Postgres ledger, every record labelled SIMULATED in API + UI
# ONCHAIN_TESTNET = wallet-signed trades on the NEAR testnet contract
QUIRE_EXECUTION_MODE=SIMULATED
# passwordless *.sim logins; only allowed with SIMULATED
QUIRE_DEV_AUTH=true

# ---------- NEAR (testnet) ----------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
QUIRE_MARKET_CONTRACT=
QUIRE_QUSD_CONTRACT=

# ---------- NEAR AI Cloud (confidential inference) ----------
# https://cloud.near.ai -> API keys (prefix sk-)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1

# ---------- NEAR Intents (1Click API, MAINNET ONLY) ----------
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# optional; https://partners.near-intents.org (without it 1Click charges 0.2%)
ONECLICK_JWT=
